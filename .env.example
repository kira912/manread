# Public canonical origin, used for canonical URLs, sitemap and Open Graph.
# On Vercel it defaults to https://$VERCEL_PROJECT_PRODUCTION_URL; set it once you use a custom domain.
NUXT_PUBLIC_SITE_URL=https://manread.example

# "anilist" (default) or "fixture" (offline dataset, used by e2e tests).
NUXT_CATALOG_PROVIDER=anilist

# Self-imposed ceiling, kept below AniList's published limit so one instance never gets throttled.
NUXT_ANILIST_REQUESTS_PER_MINUTE=25

NUXT_LOG_LEVEL=info
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For (automatic on Vercel).
NUXT_TRUST_PROXY=false

# Bearer token protecting /api/metrics (leave empty to disable the endpoint).
NUXT_METRICS_TOKEN=

# Analytics (all optional, cookieless).
# Vercel Web Analytics + Speed Insights turn on automatically on Vercel once enabled in the dashboard.
# Umami Cloud (free tier) for product events: paste the website ID from cloud.umami.is.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# Search engine ownership verification (content of the meta tag only).
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BING_SITE_VERIFICATION=
